# Clave de Google AI Studio (Gemini). Se usa SOLO en el servidor. Nunca la subas
# al repositorio ni la pongas en variables VITE_*.
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_real_de_google_ai_studio

# Opcional: modelo a utilizar (por defecto gemini-3.5-flash-lite).
# Google deprecó gemini-2.5-flash; respaldos: gemini-3.8-flash y gemini-3.6-flash.
GEMINI_MODEL=gemini-3.5-flash-lite

# Configuración web PÚBLICA de Firebase (se inyecta en el bundle del navegador).
# No son secretos: la seguridad la dan las reglas de Firestore/Storage.
VITE_FIREBASE_API_KEY=tu_api_key_web
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# URL pública del servicio de IA. En local se deja vacía para usar el middleware
# de Vite (/api/gemini). En el sitio publicado en S3 debe apuntar al backend
# desplegado, por ejemplo: https://mi-api.vercel.app/api/gemini
VITE_AI_ENDPOINT=

# `mock` (por defecto): si el servicio de IA falla, muestra recomendaciones de
# demostración marcadas como tales. `off`: muestra solo el error controlado.
VITE_AI_FALLBACK=mock

# Solo servidor: orígenes permitidos por CORS, separados por coma.
# Usa `*` mientras el endpoint no maneje cookies ni credenciales.
ALLOWED_ORIGINS=*
